# App URL (required for Vercel: set to your deployment URL, e.g. https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL=

# Strapi backend URL (required for Vercel: set to your deployed Strapi URL, e.g. https://your-strapi.up.railway.app)
NEXT_PUBLIC_STRAPI_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Strapi API token (create in Strapi Admin → Settings → API Tokens)
NEXT_PUBLIC_REST_API_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHER_KEY=
STRIPE_SECRET_KEY=

# Resend (order confirmation emails)
RESEND_API_KEY=
